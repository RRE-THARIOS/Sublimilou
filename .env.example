# Copie ce fichier en .env pour le dev local (netlify dev charge .env automatiquement)

# Obligatoire pour l'import YouTube quand Piped/Invidious sont down
# Clé gratuite : https://cobalt.tools
COBALT_API_KEY=

# Recommandé — phrase secrète pour sécuriser le proxy audio
YOUTUBE_PROXY_SECRET=change-moi-en-local

# Optionnel
COBALT_API_URL=https://api.cobalt.tools
