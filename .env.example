# Copie en .env pour le dev local (chargé par le serveur si tu utilises dotenv manuellement)
# Sur Fly : fly secrets set COBALT_API_KEY=… YOUTUBE_PROXY_SECRET=…

# Recommandé en prod — import YouTube fiable depuis le cloud
COBALT_API_KEY=

# Phrase secrète pour le proxy audio (obligatoire en prod)
YOUTUBE_PROXY_SECRET=change-moi-en-local

# Optionnel — cookies YouTube pour yt-dlp (contourne le blocage « not a bot » sur Fly)
# Dev local : chemin vers un fichier Netscape exporté (ne jamais committer)
# YTDLP_COOKIES_PATH=./cookies.txt
# Fly : fly secrets set YTDLP_COOKIES_B64="$(base64 < cookies.txt | tr -d '\n')"

COBALT_API_URL=https://api.cobalt.tools
PORT=8080
YTDLP_PATH=/usr/local/bin/yt-dlp

# Supabase (optionnel) — synchro cloud des pistes + playlists
# Côté front (Vite): préfixe VITE_ obligatoire
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
